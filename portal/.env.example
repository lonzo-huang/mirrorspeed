# ============================================================
# 复制为 .env.local，填入实际值，不要提交到 Git
# ============================================================

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 仅服务端使用，永不暴露给客户端

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...                      # 生产: sk_live_  测试: sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...                    # stripe listen --forward-to localhost:3000/api/webhooks/stripe

# Stripe Price IDs（在 Stripe Dashboard 创建 Monthly VPN 套餐后填入）
STRIPE_PRICE_USD=price_xxx
STRIPE_PRICE_EUR=price_xxx
STRIPE_PRICE_CNY=price_xxx

# ── VPN 服务器 ───────────────────────────────────────────────
VPN_API_BASE_URL=https://vpn.yourcompany.com:8443  # VPN 服务器上 FastAPI 的地址
VPN_API_SECRET=your-long-random-secret-key         # 与 FastAPI 共享的 API 密钥
VPN_SERVER_ENDPOINT=vpn.yourcompany.com            # WireGuard 对外端点（域名）
VPN_SERVER_PORT=51820
VPN_SERVER_PUBLIC_KEY=                             # 服务端 WireGuard 公钥

# ── 应用 ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://portal.yourcompany.com
APP_ENCRYPTION_SECRET=32-chars-random-secret-key  # 用于加密存储 WireGuard 私钥

# ── Cron 鉴权（Vercel Cron Job 请求头验证）──────────────────
CRON_SECRET=your-cron-secret-key                  # 与 vercel.json cron 配置对应
