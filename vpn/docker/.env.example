# Domain name for TLS certificate (must point to this server's IP)
DOMAIN=vpn.example.com

# Email for Let's Encrypt notifications
EMAIL=admin@example.com

# Secret key shared between portal and vpn-api (generate with: openssl rand -hex 32)
VPN_API_SECRET=change-me-use-a-long-random-secret

# WireGuard UDP listen port
WG_PORT=39666
