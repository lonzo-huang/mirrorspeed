# VPN API 服务端环境变量

# 与 portal vpn_servers.api_secret 字段一致
VPN_API_SECRET=your-long-random-secret-key-same-as-portal

# AWG 接口名（默认 awg0；标准 WireGuard 改为 wg0）
WG_INTERFACE=awg0

# Peer 元数据目录的父目录（06-peer-manager.sh 将文件存储在此目录下的 peers/ 子目录）
# 默认 /etc/wireguard（Peer 文件路径：/etc/wireguard/peers/*.meta/.private/.psk）
WG_DIR=/etc/wireguard
