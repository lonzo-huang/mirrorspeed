<?xml version="1.0" encoding="UTF-8"?>
<!-- Runner(主 App)entitlements：管理 NETunnelProviderManager 需要 NE 权限；
     与 PacketTunnel 扩展共享数据需要 App Group。
     在 Xcode → Runner target → Signing & Capabilities 里加
     "Network Extensions"(勾 Packet Tunnel)+ "App Groups"(group.com.mirrorspeed.mirrorspeedVpn)
     会自动写入本文件；这里预置一份，省得手填。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.developer.networking.networkextension</key>
  <array>
    <string>packet-tunnel-provider</string>
  </array>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.mirrorspeed.mirrorspeedVpn</string>
  </array>
</dict>
</plist>
