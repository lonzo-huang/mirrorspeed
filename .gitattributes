# Default: auto line endings
* text=auto

# Shell scripts must stay LF on all platforms
*.sh   text eol=lf
*.py   text eol=lf
*.service text eol=lf

# Web source: LF preferred
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
